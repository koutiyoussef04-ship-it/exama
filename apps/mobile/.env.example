# Exama mobile app config (local development). Copy to apps/mobile/.env only if you need it.
#
# ⚠ Everything here is PUBLIC: EXPO_PUBLIC_* values are embedded in the app bundle.
# Never put API keys, workspace IDs, JWT secrets, Apple keys or database URLs here — those live
# only in apps/api/.env on the server.
#
# Release builds (EAS profiles "preview"/"production") take these values from the EAS environment
# instead — see docs/release/eas-build.md. There, EXPO_PUBLIC_API_URL is required and must be
# https:// on a public host (the build fails otherwise).

# Development: by default the app calls the API on the PC that serves the app (Expo LAN mode),
# port 4000 — no setting needed. Set this only for tunnel mode or the wrong network adapter:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000

# Shown on the Support / Privacy / Terms screens (placeholders are shown while empty).
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# EXPO_PUBLIC_COMPANY_NAME=Your Company
# EXPO_PUBLIC_COMPANY_ADDRESS=Street, City, Country
