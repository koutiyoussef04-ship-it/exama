{
  "name": "@study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env --test test/flow.test.ts test/anthropic.test.ts test/anthropic-flow.test.ts test/config.test.ts test/analytics.test.ts test/billing.test.ts test/account.test.ts test/multilingual.test.ts test/apple.test.ts test/apple-verifier.test.ts test/password-reset.test.ts test/google-billing.test.ts test/plans.test.ts test/pptx.test.ts test/planner.test.ts test/study-plan.test.ts test/materials.test.ts test/media.test.ts test/assemblyai.test.ts",
    "ai:check": "tsx --env-file=.env scripts/ai-check.ts",
    "transcription:check": "tsx --env-file=.env scripts/transcription-check.ts",
    "analytics:report": "tsx --env-file=.env scripts/analytics-report.ts",
    "owner:check": "tsx --env-file=.env scripts/owner-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@apple/app-store-server-library": "^3.1.0",
    "@hono/node-server": "^2.1.1",
    "@study/shared": "*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
