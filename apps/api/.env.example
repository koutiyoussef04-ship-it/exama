# Server-side configuration for the Exama API. This file is NEVER sent to the mobile app.
# Production values and guards: docs/release/eas-build.md §3.
# Create your own copy with:  npm run setup   (writes apps/api/.env with a random JWT_SECRET)

PORT=4000

# Postgres connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Matches docker-compose.yml. With the Windows Postgres installer, use the password you chose during install.
# `npm run db:migrate` creates the database if it doesn't exist yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/study_app

# Signs login tokens. `npm run setup` fills this in for you (any random string of 32+ characters).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------------- AI ----------------
# mock      = fake, offline AI (default; no key needed; questions are labelled [mock])
# anthropic = real Claude. Requires ANTHROPIC_API_KEY below.
AI_PROVIDER=mock

# Your Anthropic API key (https://console.anthropic.com → API Keys). Starts with "sk-ant-".
# Paste it after the = sign, no quotes or spaces. Keep this file private; it is git-ignored.
ANTHROPIC_API_KEY=

# Optional. Only needed if Anthropic says: "This API key is not scoped to a workspace, so this
# request must include the anthropic-workspace-id header". Find it in the Claude Console →
# Settings → Workspaces (starts with "wrkspc_"). Sent as the anthropic-workspace-id header; server-side only.
ANTHROPIC_WORKSPACE_ID=

# Model id (see https://platform.claude.com/docs/en/models/overview)
AI_MODEL=claude-sonnet-5

# ---------------- Files ----------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# ---------------- Billing ----------------
# Owner accounts: permanent full access (no paywall/trial/expiry). Comma-separated, server-side only.
# Use your account's email and/or user id (find the id with: npm run owner:check -- you@example.com).
OWNER_EMAILS=
OWNER_USER_IDS=

# Development billing: lets signed-in users start trials/subscriptions WITHOUT payment, to test states.
# Keep false/empty in production (the API refuses to start with it on when NODE_ENV=production).
BILLING_MOCK_ENABLED=false

# Optional JSON to tune plan limits without a code change (partial; see apps/api/src/billing/limits.ts).
# Tiers: free, trial, basic, student, pro. Trial counters cover the whole 7-day trial (default: 1 course,
# 1 PDF/PowerPoint upload, 1 exam of max 8 questions, 5 practice questions, 1 lecture ≤ 30 min).
# Free's lecture limits (default: 1 lecture, 45 min) count per ACCOUNT, never per month, e.g.
# PLAN_LIMITS_OVERRIDE={"free":{"examGenerationsPerMonth":5},"trial":{"practiceQuestionsPerMonth":5}}
PLAN_LIMITS_OVERRIDE=
# Optional: switch features per tier (lectures, adaptivePractice, weakTopicAnalysis, adaptivePlanner), e.g.
# PLAN_FEATURES_OVERRIDE={"basic":{"weakTopicAnalysis":true}}. Default: see apps/api/src/billing/features.ts.
PLAN_FEATURES_OVERRIDE=

# ---------------- Lecture audio & video ----------------
# mock = fake transcripts (default in development, refused in production)
# assemblyai = real transcription (https://www.assemblyai.com → API keys)
# disabled = PDFs only (the default when NODE_ENV=production and this is empty)
TRANSCRIPTION_PROVIDER=mock
# Server-side only, never in the app. Paste after the = sign, no quotes.
ASSEMBLYAI_API_KEY=
# EU data residency: https://api.eu.assemblyai.com (needs a key from an EU project).
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# Priority order. "universal-2" alone is ~29% cheaper (see docs/materials/cost-model.md).
ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2
# Hard limits (whatever the plan says): largest upload, longest lecture.
MEDIA_MAX_UPLOAD_MB=1024
MEDIA_MAX_MINUTES_PER_FILE=240
# Lectures processed at the same time by this server; unfinished lectures per student; uploads per student per hour.
MEDIA_MAX_CONCURRENT_JOBS=2
MEDIA_MAX_ACTIVE_PER_USER=2
MEDIA_UPLOADS_PER_HOUR=20
# Failed uploads keep their file this many days so the student can retry, then it's deleted.
MEDIA_FAILED_RETENTION_DAYS=7
# Optional: give up on a transcription after this many seconds (default 10 min + half the lecture length).
MEDIA_TRANSCRIPTION_TIMEOUT_SECONDS=

# ---------------- Production ----------------
# Set NODE_ENV=production on the production server: it then refuses to start with AI_PROVIDER=mock,
# TRANSCRIPTION_PROVIDER=mock, BILLING_MOCK_ENABLED=true or the template JWT_SECRET.
# NODE_ENV=production

# ---------------- Email (password reset) ----------------
# "Forgot password?" emails a one-time 6-digit code. log = print emails to the server log (development
# only); resend = send with Resend (https://resend.com); disabled = no email (reset can't work).
# Unset: log in development, disabled in production.
EMAIL_PROVIDER=
# Resend API key (SECRET — server only) and the sender; the sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------- App Store (iOS) ----------------
# See docs/app-store/apple-subscriptions.md. Off until App Store Connect is set up: iOS purchases are
# then refused (the app shows "coming soon"), nothing else changes.
# iOS bundle id; App Store transactions for any other app are rejected.
APPLE_BUNDLE_ID=com.exama.app
# true = accept App Store purchases (verified with Apple's certificates in apps/api/certs/apple).
APPLE_IAP_ENABLED=false
# The app's numeric Apple ID (App Store Connect → App Information). Required for Production purchases.
APPLE_APP_APPLE_ID=
# Accept Sandbox purchases (TestFlight, App Review). Keep true — App Review buys in the Sandbox.
APPLE_ALLOW_SANDBOX=true
# Check Apple's certificates for revocation (OCSP, outbound HTTPS to Apple). Keep true in production.
APPLE_ONLINE_CHECKS=true
# Optional: another folder of Apple root certificates (.cer). Default: apps/api/certs/apple.
APPLE_ROOT_CERTS_DIR=

# ---------------- Google Play Billing (Android) ----------------
# See docs/google-play/google-play-billing.md. Leave empty until the Play Console is set up:
# Android purchases are then refused (the app shows "not available yet"), nothing else changes.
# Android package name; Play purchases for any other app are rejected.
GOOGLE_PLAY_PACKAGE_NAME=com.exama.app
# Service-account key with Play Console access ("View financial data" + "Manage orders and
# subscriptions"): the downloaded JSON on one line, or base64 of the file. SECRET — server only.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Real-time developer notifications (Pub/Sub push to https://<api>/billing/google/notifications):
# the push subscription's OIDC audience, and the service account email it authenticates as.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Browser origins allowed to call the API (only needed for the Expo web build), comma-separated.
# Empty: any origin in development, none in production. Native apps don't use CORS.
CORS_ORIGINS=
