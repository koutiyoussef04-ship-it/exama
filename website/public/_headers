# Response headers for static hosts that read a `_headers` file (Cloudflare Pages, Netlify).
# Other hosts (e.g. Vercel): set the same headers in that host's own config.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
