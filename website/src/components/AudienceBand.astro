---
/** Under the student hero: academies and training centers are sent to the organizations page (English or Spanish). */
import Icon from './Icon.astro';
import { copy, isOrgLang, orgLangFor, orgPathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy(lang).audience;
const href = orgPathFor(orgLangFor(lang));
const attrs = isOrgLang(lang) ? {} : { hreflang: 'en' };
---

<aside class="audience-band" aria-label={c.link}>
  <div class="container audience-inner">
    <span class="card-icon audience-icon" aria-hidden="true"><Icon name="building" size={22} /></span>
    <p>{c.text}</p>
    <a class="audience-link" href={href} {...attrs}>{c.link} <Icon name="arrowRight" size={18} class="flip-rtl" /></a>
  </div>
</aside>
