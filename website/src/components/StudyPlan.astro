---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).plan;
---

<section id="study-plan" class="section section-alt" aria-labelledby="plan-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="plan-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
    </div>

    <div class="plan-grid">
      <div>
        <h3 class="plan-heading">{c.inputsTitle}</h3>
        <ul class="plan-inputs">
          {c.inputs.map((i) => (
            <li>
              <span class="card-icon"><Icon name={i.icon} size={22} /></span>
              <div>
                <strong>{i.title}</strong>
                <p>{i.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="plan-arrow" aria-hidden="true"><Icon name="arrowRight" size={28} class="flip-rtl" /></div>

      <div class="plan-out">
        <h3 class="plan-heading">{c.outputsTitle}</h3>
        <ul class="checks">
          {c.outputs.map((o) => (
            <li><Icon name="check" size={20} /><span>{o}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <p class="fineprint center">{site.webCheckoutAvailable ? c.fineTrial : c.fineFree}</p>
  </div>
</section>
