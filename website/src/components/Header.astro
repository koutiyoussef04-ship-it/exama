---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import Icon from './Icon.astro';
import LoginMenu from './LoginMenu.astro';
import Wordmark from './Wordmark.astro';
import { ORG_SECTIONS } from '../data/b2b';
import { SECTIONS, TRIAL_DAYS } from '../data/content';
import { site } from '../config/site';
import { copy, homeAnchor, isOrgLang, LANG_NAMES, orgAnchor, orgLangFor, orgPathFor, pathFor, studentAnchor, studentPathFor, type Lang } from '../i18n';
import { orgCopy } from '../i18n/b2b';

interface Props {
  lang: Lang;
  /** The same page in every language (language selector). */
  alternates: { lang: Lang; path: string }[];
  /**
   * The home page (default), the student landing page or the organizations pages: different sections, a different
   * main button. 'students' is the home navigation with its anchors on the student page itself.
   */
  nav?: 'student' | 'students' | 'org';
}
const { lang, alternates, nav = 'student' } = Astro.props;
const c = copy(lang);
// The organizations pages exist in every language of the site.
const orgLang = orgLangFor(lang);
const orgHref = orgPathFor(orgLang);
const orgLinkAttrs = isOrgLang(lang) ? {} : { hreflang: 'en' };
const org = nav === 'org' ? orgCopy(orgLang) : null;
const navLinks = org
  ? [
      { label: org.nav.how, href: orgAnchor(orgLang, ORG_SECTIONS.how) },
      { label: org.nav.pricing, href: orgAnchor(orgLang, ORG_SECTIONS.pricing) },
      { label: org.nav.faq, href: orgAnchor(orgLang, ORG_SECTIONS.faq) },
      { label: org.nav.demo, href: orgPathFor(orgLang, 'demo') },
      // To the student landing page: in the mobile menu only (the logo already links to the home; the bar is full).
      { label: org.nav.students, href: studentPathFor(lang), attrs: {}, menuOnly: true },
    ]
  : [
      // On the student landing page the section links stay on that page; on the home page (and the legal pages) they go to the home sections.
      { label: c.nav.how, href: nav === 'students' ? studentAnchor(lang, SECTIONS.how) : homeAnchor(lang, SECTIONS.how) },
      { label: c.nav.materials, href: nav === 'students' ? studentAnchor(lang, SECTIONS.materials) : homeAnchor(lang, SECTIONS.materials) },
      { label: c.nav.pricing, href: nav === 'students' ? studentAnchor(lang, SECTIONS.pricing) : homeAnchor(lang, SECTIONS.pricing) },
      { label: c.nav.faq, href: homeAnchor(lang, SECTIONS.faq) },
      { label: c.nav.students, href: studentPathFor(lang), attrs: {}, menuOnly: true },
      { label: c.nav.organizations, href: orgHref, attrs: orgLinkAttrs },
    ];
const ctaLabel = org ? org.cta.pilotShort : site.webCheckoutAvailable ? c.cta.trial(TRIAL_DAYS) : c.cta.free;
const ctaHref = org ? site.links.orgSignUp(lang) : site.links.primary(lang);
// "Log in" is a choice between the two identities (LoginMenu); the organizations pages list the organization one first.
const loginPrimary = org ? 'organization' : 'student';
const loginLinks = [
  { label: c.nav.loginStudent, href: site.links.signIn(lang), kind: 'student' },
  { label: c.nav.loginOrganization, href: site.links.orgSignIn(lang), kind: 'organization' },
];
if (org) loginLinks.reverse();
---

<header class:list={['site-header', { 'site-header-org': !!org }]}>
  <div class="container header-bar">
    <a class="brand" href={org ? orgPathFor(orgLang) : pathFor(lang)} aria-label={org ? org.meta.title : c.ui.homeAria}>
      <Image src={logoMark} alt="" width={36} height={36} class="brand-mark" loading="eager" />
      <Wordmark />
    </a>

    <nav class="nav-desktop" aria-label={c.ui.primaryNav}>
      <ul>
        {navLinks.filter((l) => !('menuOnly' in l)).map((l) => <li><a href={l.href} {...(l.attrs ?? {})}>{l.label}</a></li>)}
      </ul>
    </nav>

    <details class="lang-menu">
      <summary aria-label={c.ui.language}><Icon name="globe" size={18} /><span>{LANG_NAMES[lang]}</span></summary>
      <ul class="lang-panel" aria-label={c.ui.language}>
        {
          alternates.map((a) =>
            a.lang === lang ? (
              <li><span aria-current="page" lang={a.lang}>{LANG_NAMES[a.lang]}</span></li>
            ) : (
              <li><a href={a.path} hreflang={a.lang} lang={a.lang}>{LANG_NAMES[a.lang]}</a></li>
            ),
          )
        }
      </ul>
    </details>

    <div class="header-login"><LoginMenu lang={lang} primary={loginPrimary} /></div>
    <a class="btn btn-primary btn-sm header-cta" href={ctaHref}>{ctaLabel}</a>

    <details class="menu">
      <summary aria-label={c.ui.menu}>
        <Icon name="menu" class="menu-open" />
        <Icon name="close" class="menu-close" />
      </summary>
      <nav class="menu-panel" aria-label={c.ui.mobileNav}>
        <ul>
          {navLinks.map((l) => <li><a href={l.href} {...(l.attrs ?? {})}>{l.label}</a></li>)}
          <li class="menu-login" aria-label={c.nav.loginAria}>
            <span class="menu-login-label">{c.nav.login}</span>
            <ul>
              {loginLinks.map((l) => <li><a href={l.href} data-account={l.kind}>{l.label}</a></li>)}
            </ul>
          </li>
        </ul>
        <a class="btn btn-primary btn-block" href={ctaHref}>{ctaLabel}</a>
      </nav>
    </details>
  </div>
</header>

<!-- Progressive enhancement: the menus open without JS; this only closes them after a link is used, on a click elsewhere or on Escape. -->
<script is:inline data-purpose="close-menu">
  (function () {
    var menus = document.querySelectorAll('.menu, .lang-menu, .login-menu');
    menus.forEach(function (menu) {
      menu.addEventListener('click', function (e) {
        if (e.target.closest('a')) menu.removeAttribute('open');
      });
    });
    document.addEventListener('click', function (e) {
      menus.forEach(function (m) { if (!m.contains(e.target)) m.removeAttribute('open'); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') menus.forEach(function (m) { m.removeAttribute('open'); });
    });
  })();
</script>
