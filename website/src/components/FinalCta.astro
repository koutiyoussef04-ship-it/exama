---
import { site } from '../config/site';
---

<section class="final-cta" aria-labelledby="final-title">
  <div class="container final-inner">
    <h2 id="final-title">Put your course material to work.</h2>
    <p>Upload it once. Get exams, grading, weak-topic practice and a study plan built from it.</p>
    <a class="btn btn-light btn-lg" href={site.cta.href}>{site.cta.label}</a>
    <p class="final-note">7 days free · Card required, no payment today · Cancel anytime before it ends</p>
  </div>
</section>
