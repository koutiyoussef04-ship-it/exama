---
import Icon from './Icon.astro';
import { SECTIONS } from '../data/content';
import { site } from '../config/site';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).materials;
---

<section id={SECTIONS.materials} class="section section-alt" aria-labelledby="materials-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="materials-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
    </div>

    <ul class="cards cards-4">
      {c.items.map((m) => (
        <li class="card">
          <span class="card-icon"><Icon name={m.icon} size={24} /></span>
          <h3>{m.name}</h3>
          <p class="card-meta" dir="ltr">{m.formats}</p>
          <p>{m.text}</p>
        </li>
      ))}
    </ul>

    <p class="fineprint">{site.webCheckoutAvailable ? c.fineTrial : c.fineFree}</p>
  </div>
</section>
