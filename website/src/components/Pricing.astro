---
import Icon from './Icon.astro';
import { formatEuros, PLAN_ORDER, PRICES, RECOMMENDED_PLAN, SECTIONS, TRIAL_DAYS, yearlySavingPct, type PaidTier } from '../data/content';
import { site } from '../config/site';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy(lang).pricing;
const cta = copy(lang).cta;
const trial = site.webCheckoutAvailable;
const plans = PLAN_ORDER.map((id) => {
  const paid = id === 'free' ? null : (id as PaidTier);
  return {
    id,
    ...c.plans[id],
    recommended: id === RECOMMENDED_PLAN,
    price: paid ? { monthly: formatEuros(PRICES[paid].monthlyCents, lang), yearly: formatEuros(PRICES[paid].yearlyCents, lang), savingPct: yearlySavingPct(paid) } : null,
    // Free: an account. Paid: sign up / sign in, then the plans screen with this plan pre-selected
    // (the trial is offered there by the server, only to eligible accounts, and only when web checkout is live).
    href: paid ? site.links.plans(lang, paid) : site.links.signUp(lang),
    label: paid ? (trial ? cta.trial(TRIAL_DAYS) : cta.choose(c.plans[id].name)) : cta.startFree,
  };
});
---

<section id={SECTIONS.pricing} class="section section-alt" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="pricing-title">{trial ? c.titleTrial(TRIAL_DAYS) : c.titleFree}</h2>
      <p class="section-lead">{trial ? c.leadTrial(TRIAL_DAYS) : c.leadFree}</p>
    </div>

    <ul class="pricing">
      {plans.map((p) => (
        <li class:list={['plan', { 'plan-recommended': p.recommended }]} data-plan={p.id}>
          <div class="plan-top">
            <h3>{p.name}</h3>
            {p.recommended && <span class="badge">{c.recommended}</span>}
          </div>
          <p class="plan-tagline">{p.tagline}</p>

          {p.price ? (
            <div class="plan-price">
              <p class="price-main"><span class="price-amount">{p.price.monthly}</span><span class="price-per">{c.perMonth}</span></p>
              <p class="price-alt">{c.orYearly(p.price.yearly, p.price.savingPct)}</p>
            </div>
          ) : (
            <div class="plan-price">
              <p class="price-main"><span class="price-amount">{c.zero}</span></p>
              <p class="price-alt">{c.noPayment}</p>
            </div>
          )}

          <ul class="plan-features">
            {p.features.map((f) => (
              <li class:list={{ off: f.off }}>
                <Icon name={f.off ? 'x' : 'check'} size={18} />
                <span>{f.text}</span>
              </li>
            ))}
          </ul>

          <a class:list={['btn', 'btn-block', p.recommended ? 'btn-primary' : 'btn-secondary']} href={p.href}>{p.label}</a>
        </li>
      ))}
    </ul>

    <p class="fineprint center">{trial ? c.fineTrial(TRIAL_DAYS) : c.fineFree}</p>
  </div>
</section>
