---
import { ORG_PILOT_DAYS } from '../../data/b2b';
import { site } from '../../config/site';
import { orgPathFor, type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';

interface Props {
  lang: OrgLang;
}
const { lang } = Astro.props;
const c = orgCopy(lang);
---

<section class="final-cta" aria-labelledby="final-title">
  <div class="container final-inner">
    <h2 id="final-title">{c.final.title}</h2>
    <p>{c.final.text}</p>
    <div class="cta-row cta-center">
      <a class="btn btn-light btn-lg" href={site.links.orgSignUp(lang)}>{c.cta.pilot(ORG_PILOT_DAYS)}</a>
      <a class="btn btn-outline-light btn-lg" href={orgPathFor(lang, 'demo')}>{c.cta.demo}</a>
    </div>
    <p class="final-note">{c.final.note}</p>
  </div>
</section>
