---
/** The "for organizations" page in one language (/for-organizations, /es/para-organizaciones). */
import Base from '../../layouts/Base.astro';
import OrgHero from './OrgHero.astro';
import OrgAudiences from './OrgAudiences.astro';
import OrgHow from './OrgHow.astro';
import OrgReview from './OrgReview.astro';
import OrgTeam from './OrgTeam.astro';
import OrgPricing from './OrgPricing.astro';
import OrgPilot from './OrgPilot.astro';
import OrgFaq from './OrgFaq.astro';
import OrgFinalCta from './OrgFinalCta.astro';
import { ORG_PILOT_DAYS } from '../../data/b2b';
import { site } from '../../config/site';
import { orgAlternatesFor, orgOgImage, orgPathFor, type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';

interface Props {
  lang: OrgLang;
}
const { lang } = Astro.props;
const c = orgCopy(lang);
// Structured data describes only what is visibly on the page (FAQ text, site name). No ratings, no reviews, no offers.
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: lang },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: c.faq.items(ORG_PILOT_DAYS).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })),
  },
];
---

<Base title={c.meta.title} description={c.meta.description} path={orgPathFor(lang)} jsonLd={jsonLd} lang={lang} alternates={orgAlternatesFor('')} nav="org" ogImage={orgOgImage(lang)} ogAlt={c.meta.ogAlt}>
  <OrgHero lang={lang} />
  <OrgHow lang={lang} />
  <OrgReview lang={lang} />
  <OrgAudiences lang={lang} />
  <OrgTeam lang={lang} />
  <OrgPricing lang={lang} />
  <OrgPilot lang={lang} />
  <OrgFaq lang={lang} />
  <OrgFinalCta lang={lang} />
</Base>
