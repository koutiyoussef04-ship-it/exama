---
import { Image } from 'astro:assets';
import logoMark from '../../assets/brand/logo-mark.png';
import Icon from '../Icon.astro';
import { ORG_SECTIONS } from '../../data/b2b';
import { orgPathFor, type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';
import { orgHeroScreenshot } from '../../lib/org-screenshots';

interface Props {
  lang: OrgLang;
}
const { lang } = Astro.props;
const c = orgCopy(lang);
const h = c.hero;
const trustIcons = ['globe', 'users', 'graded', 'export'];
const inputIcons = ['pdf', 'slides'];
const outputIcons = ['check', 'pdf', 'export'];
/**
 * The hero shows the REAL review screen as soon as its capture exists (src/lib/org-screenshots.ts: a genuine capture
 * of app.exama.app/org in the page's language — never a mock-up, never the Spanish capture on the French page).
 * Until then: the diagram of the workflow.
 */
const shot = orgHeroScreenshot(lang);
---

<section class:list={['hero', 'org-hero', { 'has-shot': !!shot }]} aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title">
        {h.titleStart}<span class="grad-text">{h.titleHighlight}</span>
      </h1>
      <p class="lead">{h.lead}</p>

      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={orgPathFor(lang, 'demo')}>{c.cta.demo}</a>
        <a class="btn btn-secondary btn-lg" href={`#${ORG_SECTIONS.pricing}`}>{c.cta.seePricing}</a>
      </div>
      <p class="cta-note">{h.note}</p>
    </div>

    {shot ? (
      <figure class="hero-shot">
        <img src={shot} alt={h.shotAlt} width="800" height="500" loading="eager" decoding="async" />
      </figure>
    ) : (
    <div class="flow" role="img" aria-label={h.flowAria}>
      <div class="flow-group flow-in">
        <p class="flow-label">{h.flowIn}</p>
        <ul>
          {h.inputs.map((label, i) => (
            <li><Icon name={inputIcons[i]!} size={18} /><span>{label}</span></li>
          ))}
        </ul>
      </div>

      <div class="flow-link" aria-hidden="true"><Icon name="arrowDown" size={20} /></div>

      <div class="flow-core">
        <Image src={logoMark} alt="" width={44} height={44} class="flow-mark" />
        <div>
          <strong>{h.flowCore}</strong>
          <span>{h.flowCoreSub}</span>
        </div>
      </div>

      <div class="flow-link" aria-hidden="true"><Icon name="arrowDown" size={20} /></div>

      <div class="flow-group flow-out">
        <p class="flow-label">{h.flowOut}</p>
        <ul>
          {h.outputs.map((label, i) => (
            <li><Icon name={outputIcons[i]!} size={18} /><span>{label}</span></li>
          ))}
        </ul>
      </div>
    </div>
    )}
  </div>
</section>

<section class="trust-strip" aria-label={h.trustAria}>
  <ul class="container trust-list">
    {h.trust.map((label, i) => (
      <li><Icon name={trustIcons[i]!} size={20} /><span>{label}</span></li>
    ))}
  </ul>
</section>
