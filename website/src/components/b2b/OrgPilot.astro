---
import Icon from '../Icon.astro';
import { ORG_LIMITS, ORG_MAX_ITEMS_PER_REQUEST, ORG_PILOT_DAYS, ORG_SECTIONS } from '../../data/b2b';
import { site } from '../../config/site';
import { type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';

interface Props {
  lang: OrgLang;
}
const { lang } = Astro.props;
const c = orgCopy(lang);
const p = c.pilot;
---

<section id={ORG_SECTIONS.pilot} class="section section-alt" aria-labelledby="pilot-title">
  <div class="container split">
    <div>
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 id="pilot-title">{p.title(ORG_PILOT_DAYS)}</h2>
      <p class="section-lead">{p.lead}</p>
      <ul class="checks">
        {p.includes(ORG_LIMITS.pilot, ORG_MAX_ITEMS_PER_REQUEST).map((line) => (
          <li><Icon name="check" size={18} /><span>{line}</span></li>
        ))}
      </ul>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={site.links.orgSignUp(lang)}>{c.cta.pilot(ORG_PILOT_DAYS)}</a>
      </div>
    </div>
    <div class="pilot-side">
    <div class="card pilot-start">
      <h3>{p.startTitle}</h3>
      <ol class="pilot-steps">
        {p.start.map((line) => <li>{line}</li>)}
      </ol>
    </div>
    <div class="card pilot-after">
      <span class="card-icon"><Icon name="clock" size={24} /></span>
      <h3>{p.afterTitle}</h3>
      <ul class="checks">
        {p.after.map((line) => (
          <li><Icon name="check" size={18} /><span>{line}</span></li>
        ))}
      </ul>
    </div>
    </div>
  </div>
</section>
