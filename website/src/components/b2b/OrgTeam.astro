---
import Icon from '../Icon.astro';
import { type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';

interface Props {
  lang: OrgLang;
}
const c = orgCopy(Astro.props.lang).team;
---

<section id="team" class="section section-alt" aria-labelledby="team-title">
  <div class="container split">
    <div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="team-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
      <dl class="roles">
        {c.roles.map((r) => (
          <div class="role">
            <dt>{r.name}</dt>
            <dd>{r.text}</dd>
          </div>
        ))}
      </dl>
      <p class="fineprint">{c.reviewersNote}</p>
    </div>
    <div class="card usage-card">
      <span class="card-icon"><Icon name="chart" size={24} /></span>
      <h3>{c.usageTitle}</h3>
      <p>{c.usageText}</p>
    </div>
  </div>
</section>
