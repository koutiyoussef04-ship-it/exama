---
import Icon from '../Icon.astro';
import { ORG_SECTIONS } from '../../data/b2b';
import { type OrgLang } from '../../i18n';
import { orgCopy } from '../../i18n/b2b';
import { orgScreenshot } from '../../lib/org-screenshots';

interface Props {
  lang: OrgLang;
}
const { lang } = Astro.props;
const c = orgCopy(lang).review;

/**
 * Real workspace screens only (src/lib/org-screenshots.ts): genuine captures of the organization workspace named
 * after each screen's id appear here automatically; until a file exists, the card shows an icon — this site never
 * mocks up screens, and the French page only ever shows French captures.
 */
const screens = c.screens.map((s) => ({ ...s, src: orgScreenshot(lang, s.id) }));
---

<section id={ORG_SECTIONS.review} class="section" aria-labelledby="review-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="review-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
    </div>
    <ul class="checks checks-grid">
      {c.points.map((p) => (
        <li><Icon name="check" size={18} /><span>{p}</span></li>
      ))}
    </ul>
    <ul class="product-grid org-screens">
      {screens.map((s) => (
        <li class="product-card">
          {s.src ? (
            <div class="shot shot-wide">
              <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
            </div>
          ) : (
            <span class="card-icon"><Icon name={s.icon} size={24} /></span>
          )}
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
