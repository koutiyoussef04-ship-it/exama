---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).weak;
---

<section id="weak-topics" class="section" aria-labelledby="weak-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="weak-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
    </div>

    <ol class="loop" aria-label={c.loopAria}>
      {c.steps.map((s, i) => (
        <li>
          <span class="loop-node">{s}</span>
          {i < c.steps.length - 1 && <Icon name="arrowRight" size={20} class="loop-arrow flip-rtl" />}
        </li>
      ))}
      <li class="loop-back">
        <Icon name="repeat" size={18} /><span>{c.back}</span>
      </li>
    </ol>

    <p class="fineprint center">{site.webCheckoutAvailable ? c.fineTrial : c.fineFree}</p>
  </div>
</section>
