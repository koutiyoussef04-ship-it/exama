---
import Icon from './Icon.astro';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).grounded;
---

<section id="grounded" class="section" aria-labelledby="grounded-title">
  <div class="container split">
    <div class="split-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="grounded-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
      <ul class="checks">
        {c.points.map((p) => (
          <li><Icon name="check" size={20} /><span>{p}</span></li>
        ))}
      </ul>
      <p class="fineprint">{c.disclaimer}</p>
    </div>

    <div class="contrast" role="group" aria-label={c.contrastAria}>
      <div class="contrast-row contrast-generic">
        <p class="contrast-label">{c.genericLabel}</p>
        <p>{c.genericText}</p>
      </div>
      <div class="contrast-row contrast-exama">
        <p class="contrast-label">{c.examaLabel}</p>
        <p>{c.examaText}</p>
        <p class="contrast-source">
          <Icon name="quote" size={18} />
          <span>{c.sourceNote}</span>
        </p>
      </div>
    </div>
  </div>
</section>
