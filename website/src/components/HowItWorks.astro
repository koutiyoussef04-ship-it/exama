---
import Icon from './Icon.astro';
import { SECTIONS } from '../data/content';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).how;
---

<section id={SECTIONS.how} class="section" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="how-title">{c.title}</h2>
    </div>

    <ol class="steps">
      {c.steps.map((s, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <span class="step-icon"><Icon name={s.icon} size={22} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
