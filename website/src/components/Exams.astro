---
import Icon from './Icon.astro';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const c = copy(Astro.props.lang).exams;
---

<section id="exams" class="section section-alt" aria-labelledby="exams-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="exams-title">{c.title}</h2>
      <p class="section-lead">{c.lead}</p>
    </div>

    <ol class="pipeline" aria-label={c.pipelineAria}>
      {c.steps.map((s, i) => (
        <li>
          <span class="pipeline-num" aria-hidden="true">{i + 1}</span>
          <span>{s}</span>
        </li>
      ))}
    </ol>

    <ul class="cards cards-4">
      {c.details.map((d) => (
        <li class="card">
          <span class="card-icon"><Icon name={d.icon} size={24} /></span>
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
