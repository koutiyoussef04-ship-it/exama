---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { copy, LANGS, LANG_NAMES, pathFor } from '../i18n';
import { TRIAL_DAYS } from '../data/content';

const c = copy('en');
const trial = site.webCheckoutAvailable;
---

<Base title="Page not found — Exama" description="This page could not be found." path="/404" noindex>
  <section class="section info-page">
    <div class="container narrow">
      <h1>Page not found</h1>
      <div class="prose">
        <p>That page does not exist. Head back to the homepage, or open the Exama app.</p>
      </div>
      <p class="cta-row">
        <a class="btn btn-secondary" href="/">Go to the homepage</a>
        <a class="btn btn-primary" href={site.links.primary('en')}>{trial ? c.cta.trial(TRIAL_DAYS) : c.cta.free}</a>
      </p>
      <p class="lang-home-links">
        {LANGS.filter((l) => l !== 'en').map((l) => <a href={pathFor(l)} lang={l} hreflang={l}>{LANG_NAMES[l]}</a>)}
      </p>
    </div>
  </section>
</Base>
