---
/** /es/privacy, /fr/privacy and /ar/privacy. English is /privacy (../privacy.astro). */
import LegalDocument from '../../components/LegalDocument.astro';
import { LEGAL_LANGS, type LegalLang } from '../../data/legal';

export function getStaticPaths() {
  return LEGAL_LANGS.filter((lang) => lang !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LegalLang };
---

<LegalDocument doc="privacy" lang={lang} />
