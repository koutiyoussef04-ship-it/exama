---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, site } from '../config/site';
import { alternatesFor, copy, dirOf, OG_LOCALE, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page on exama.app, e.g. "/" or "/privacy". Used for the canonical URL. */
  path?: string;
  /** Keep the page out of search results (interim pages, and the legal pages while their text is a draft). */
  noindex?: boolean;
  /** JSON-LD objects to embed (structured data). */
  jsonLd?: Record<string, unknown>[];
  /** Language of the page (en, es, fr or ar): text, direction (Arabic is right-to-left), header and footer. */
  lang?: Lang;
  /** The same page in every language: <link rel="alternate" hreflang> and the language selector. */
  alternates?: { lang: Lang; path: string }[];
  /** Which navigation the header and footer show: the student site (default) or the organizations pages. */
  nav?: 'student' | 'org';
  /** Link-preview image (path on exama.app, 1200×630). Default: the student site's. */
  ogImage?: string;
  /** Description of the link-preview image. Default: the student site's. */
  ogAlt?: string;
}

const { lang = 'en', path = '/', noindex = false, jsonLd = [], alternates = alternatesFor(''), nav = 'student', ogImage: ogImagePath = site.ogImage.path, ogAlt } = Astro.props;
const c = copy(lang);
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(ogImagePath);
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absoluteUrl(a.path)} />)}
    {alternates.some((a) => a.lang === 'en') && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.find((a) => a.lang === 'en')!.path)} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#15173F" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={ogAlt ?? c.meta.ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt ?? c.meta.ogAlt} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{c.ui.skip}</a>
    <Header lang={lang} alternates={alternates} nav={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} nav={nav} />
  </body>
</html>
